<view class="feed"><view wx:for="{{columns}}" wx:for-item="column" wx:for-index="columnIndex" wx:key="index" class="column"><view wx:for="{{column}}" wx:key="id" class="post"><button class="post-open" data-id="{{item.id}}" bindtap="open"><p-image wx:if="{{item.image}}" image-class="photo" src="{{item.image}}" mode="widthFix" data-src="{{item.image}}" bindload="imageLoaded" lazy-load /><view class="tag"># {{item.tag}}</view><text class="title">{{item.title}}</text></button><view class="meta"><view class="byline"><text class="byline-text">{{item.author}}</text><text class="byline-text time">{{item.editedText}}编辑</text></view><button wx:if="{{allowSave}}" class="save" data-id="{{item.id}}" catchtap="save" aria-label="{{item.saved ? '取消收藏' : '收藏'}}"><p-icon name="{{item.saved ? 'saved' : 'save'}}" tone="{{item.saved ? 'primary' : 'muted'}}" size="30" /></button></view></view></view></view>
