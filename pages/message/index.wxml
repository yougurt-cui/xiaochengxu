<view class="page">
  <view style="height: {{statusBarHeight}}px"></view>
  <view class="navbar">
    <view class="brand-cat">🐱</view>
    <text class="title">猫咪瞬间墙</text>
    <view class="nav-actions"><text bindtap="comingSoon">⌕</text><text class="add" bindtap="comingSoon">＋</text></view>
  </view>

  <view class="hero">
    <view class="topic"><text class="hash">#</text><text>本周话题：</text></view>
    <text class="hero-title">今天也被猫拿捏了</text>
    <button class="hero-button" bindtap="comingSoon">去晒图 〉</button>
    <image class="hero-photo p1" src="/static/moments/cat-1.webp" mode="aspectFill" />
    <image class="hero-photo p2" src="/static/moments/cat-2.webp" mode="aspectFill" />
    <image class="hero-photo p3" src="/static/moments/cat-3.webp" mode="aspectFill" />
    <text class="hero-heart">♥</text>
  </view>

  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="categories">
      <view wx:for="{{categories}}" wx:key="id" class="category {{item.active ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.emoji}} {{item.label}}</view>
    </view>
  </scroll-view>

  <view class="waterfall">
    <view class="column">
      <view wx:for="{{leftPosts}}" wx:key="id" class="post">
        <view class="photo"><image src="{{item.image}}" mode="aspectFill" /><text class="post-tag">{{item.emoji}} {{item.tag}}</text></view>
        <view class="post-body"><text class="post-title">{{item.title}}</text><view class="post-meta"><view class="author"><text class="author-avatar">{{item.avatar}}</text><text>{{item.author}}</text></view><view class="stats"><text class="like {{item.liked ? 'liked' : ''}}" data-id="{{item.id}}" bindtap="toggleLike">♥ {{item.likes}}</text><text>◯ {{item.comments}}</text></view></view></view>
      </view>
    </view>
    <view class="column">
      <view wx:for="{{rightPosts}}" wx:key="id" class="post">
        <view class="photo"><image src="{{item.image}}" mode="aspectFill" /><text class="post-tag">{{item.emoji}} {{item.tag}}</text></view>
        <view class="post-body"><text class="post-title">{{item.title}}</text><view class="post-meta"><view class="author"><text class="author-avatar">{{item.avatar}}</text><text>{{item.author}}</text></view><view class="stats"><text class="like {{item.liked ? 'liked' : ''}}" data-id="{{item.id}}" bindtap="toggleLike">♥ {{item.likes}}</text><text>◯ {{item.comments}}</text></view></view></view>
      </view>
    </view>
  </view>

  <view class="record" bindtap="comingSoon"><text>▣</text><text>记录</text></view>
</view>
