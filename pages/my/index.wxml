<view class="page tab-page"><page-header title="宠物" /><view class="screen-body"><view class="pet-heading"><text class="eyebrow">MY LITTLE WORLD</text><text class="hero-title">{{pet ? pet.name + '的小天地' : '它的小天地'}}</text><text class="caption">吃得开心，玩得尽兴，被好好爱着。</text></view><button class="pet-card" bindtap="editPet"><view class="pet-circle {{pet ? 'has-pet' : ''}}"><p-icon name="{{pet ? (pet.type === '狗狗' ? 'dog' : 'cat') : 'plus'}}" tone="inverse" size="{{pet ? 64 : 42}}" /><view class="pet-badge"><p-icon name="{{pet.type === '狗狗' ? 'dog' : 'cat'}}" tone="accentText" size="30" /></view></view><view class="pet-copy"><text class="pet-name">{{pet ? pet.name : '添加你的第一只宠物'}}</text><text class="pet-meta">{{pet ? (pet.breed || pet.type) + ' · ' + pet.age + ' 岁 · ' + pet.weight + ' kg' : '从认识它开始，建立专属档案'}}</text><text class="pet-edit">{{pet ? '查看 / 编辑档案' : '添加宠物档案'}} ↗</text></view></button>
<view class="pet-shelves"><button data-kind="toys" bindtap="openSupplies"><view class="shelf-icon"><p-icon name="toy" size="48" /></view><text>我的玩具</text><text class="caption">{{toysCount ? toysCount + ' 件陪伴小物' : '收藏它的快乐'}}</text><text class="shelf-arrow">↗</text></button><button data-kind="food" bindtap="openSupplies"><view class="shelf-icon"><p-icon name="food" tone="accentText" size="48" /></view><text>我的食物</text><text class="caption">{{foodCount ? foodCount + ' 份饮食记录' : '记住喜欢的味道'}}</text><text class="shelf-arrow">↗</text></button></view>
<view class="section-heading parent-heading"><text>爸爸妈妈的资料</text><text>一起照顾它的人</text></view><button class="parent-card" bindtap="editParent"><p-image wx:if="{{parent.image}}" image-class="parent-avatar" src="{{parent.image}}" mode="aspectFill" /><view wx:else class="parent-avatar"><p-icon name="cat" tone="muted" /></view><view class="parent-copy"><text>{{parent.name}}</text><text class="caption">微信资料 · 编辑昵称</text></view><p-icon name="arrow" tone="muted" size="28" /></button><view class="profile-links"><button class="menu-row" bindtap="openFavorites"><p-icon name="save" /><view class="row-copy">我的收藏</view><view class="profile-end"><text>{{favoriteCount}}</text><p-icon name="arrow" tone="muted" size="26" /></view></button><button class="menu-row" bindtap="openPosts"><p-icon name="post" /><view class="row-copy">我的帖子</view><view class="profile-end"><text>{{postCount}}</text><p-icon name="arrow" tone="muted" size="26" /></view></button></view><view class="utilities"><button bindtap="goHelp">帮助与反馈</button><text>·</text><button bindtap="goSettings">设置</button></view></view></view>
