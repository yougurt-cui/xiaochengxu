<view class="page has-page-actions"><page-header title="爸爸妈妈的资料" back /><view class="screen-body"><button class="choose-avatar" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><p-image image-class="avatar-photo" wx:if="{{image}}" src="{{image}}" mode="aspectFill" /><p-icon wx:else name="cat" size="64" /></button><view class="avatar-tip">轻点设置微信头像</view><view class="form-field"><text>微信昵称</text><input type="nickname" value="{{name}}" maxlength="20" bindinput="onNameChange" bindblur="onNameChange" placeholder="怎么称呼你？" /></view><text class="caption">头像和昵称由你选择，通过微信登录同步到账号。</text></view></view>

<view class="page-action-footer"><button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="onSaveInfo">保存资料</button></view>
