<view class="page has-page-actions"><page-header title="爸爸妈妈的资料" back /><view class="screen-body"><button class="choose-avatar" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><p-image image-class="avatar-photo" wx:if="{{image}}" src="{{image}}" mode="aspectFill" /><p-icon wx:else name="cat" size="64" /></button><view class="avatar-tip">轻点设置微信头像</view><view class="form-field"><text>微信昵称</text><input type="nickname" value="{{name}}" maxlength="20" bindinput="onNameChange" bindblur="onNameChange" placeholder="怎么称呼你？" /></view><text class="caption">{{signedIn ? '头像和昵称由你选择，保存后同步到账号。' : '使用微信登录，首次登录自动注册。登录后即可保存宠物资料、咨询管家和发帖。'}}</text></view></view>

<view class="page-action-footer"><button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="onSaveInfo">{{signedIn ? '保存资料' : '微信登录／注册'}}</button></view>
