<view class="page tab-page home-page"><page-header title="宠物日常" /><view class="screen-body"><view class="home-hero"><image src="/static/design/home-hero.png" mode="aspectFit" /><text class="home-hero-title">每个日常，
都值得好好照顾</text><text class="caption">记录陪伴，也分享生活</text></view>
  <view class="home-overview {{hasDailyRecords ? 'has-records' : ''}}">
    <view class="overview-card">
      <button class="overview-heading" bindtap="openAllReminders" aria-label="打开提醒日历"><text class="overview-title">提醒日历</text><text class="overview-meta">{{calendarMonth}}月</text></button>
      <view class="overview-body">
        <view class="overview-week" bindtap="openCalendar" role="button" aria-label="查看完整日历">
          <view wx:for="{{calendarDays}}" wx:key="key" class="overview-day {{item.today ? 'is-today' : ''}}"><text class="overview-weekday">{{item.week}}</text><text class="overview-date">{{item.day}}</text><view wx:if="{{item.count}}" class="overview-dot"></view></view>
        </view>
      </view>
      <button class="overview-action overview-reminder-action" bindtap="openReminderAction">{{calendarCount ? '查看提醒 · ' + calendarCount + '项' : '＋ 添加提醒'}}</button>
    </view>
    <view class="overview-card">
      <view class="overview-heading"><button class="overview-title" bindtap="goHealthAttention" aria-label="今日状态，查看健康关注">今日状态</button><button class="overview-meta" bindtap="goHistory">历史 ›</button></view>
      <view wx:if="{{!hasDailyRecords}}" class="overview-body overview-empty">
        <button wx:for="{{metrics}}" wx:key="key" class="overview-icon-tile" data-key="{{item.key}}" bindtap="openRecord" aria-label="{{'记录' + item.label}}"><image src="/static/theme/{{item.key}}-muted.svg" mode="aspectFit" /></button>
      </view>
      <view wx:else class="overview-body overview-values">
        <button wx:for="{{metrics}}" wx:key="key" class="overview-value-row" data-key="{{item.key}}" bindtap="openRecord" aria-label="{{'记录' + item.label}}"><text>{{item.label}}</text><text class="overview-value">{{item.hasValue ? item.value + ' ' + item.unit : '—'}}</text></button>
      </view>
      <view class="overview-footer"><button class="overview-action overview-record-action" bindtap="openRecord">手动记录</button><button class="overview-device" bindtap="openDevices">{{deviceLoading || deviceError ? '查看设备' : deviceCount ? '我的设备' : '绑定设备'}}</button></view>
    </view>
  </view>
  <view class="section-heading"><text>大家都在聊</text><text>真实经历，相互陪伴</text></view><view class="search-box"><image class="search-image" src="/static/design/search.svg" /><input placeholder="搜一搜，宠物遇到的小问题" value="{{query}}" bindinput="onSearch" /></view><view class="category-tabs"><block wx:for="{{categories}}" wx:key="id"><picker wx:if="{{item.id === 'all'}}" class="feed-mode-picker" mode="selector" range="{{feedModes}}" value="{{feedModeIndex}}" bindchange="selectFeedMode"><view class="category-tab feed-mode-trigger {{category === 'all' ? 'active' : ''}}" aria-label="切换全部、热门或最新">{{feedModes[feedModeIndex]}}<text class="feed-mode-arrow">▾</text></view></picker><button wx:else class="category-tab {{category === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.label}}</button></block></view><view wx:if="{{loading}}" class="empty-state">正在加载大家的分享…</view><view wx:if="{{feedError}}" class="empty-state">{{feedError}}<button class="text-button" bindtap="loadFeed">重新加载</button></view><post-feed appearance="airy" posts="{{posts}}" bind:open="openPost" bind:save="toggleSave" /><view wx:if="{{!posts.length && !loading && !feedError}}" class="empty-state">没有找到相关帖子，试试其他关键词。</view>
</view><button wx:if="{{!showRecord}}" class="halloween-float" bindtap="openHalloween" aria-label="万圣节活动，领取生图兑换码"><image src="/static/activity/halloween-cat.png" mode="aspectFill" /><text class="halloween-float-label">领生图码</text></button><button class="floating-publish" bindtap="goRelease" aria-label="发布瞬间"><view class="publish-disc">＋ 瞬间</view></button></view>
<view wx:if="{{showRecord}}" class="sheet-mask" bindtap="closeSheet"></view>
<view wx:if="{{showRecord}}" class="bottom-sheet"><view class="sheet-heading"><text>{{recordTitle}}</text><button bindtap="closeSheet" aria-label="关闭"><p-icon name="close" /></button></view>
<text class="caption">填写本次值，保存后自动累加到今天。{{recordFields.length > 1 ? '可只填写需要记录的项目。' : ''}}</text>
<view wx:for="{{recordFields}}" wx:key="key" class="form-field"><view class="record-field-heading"><text>{{item.label}}（{{item.unit}}）</text><text class="record-total">今日累计 {{item.total}} {{item.unit}}</text></view><view wx:if="{{item.key === 'litter'}}" class="litter-inputs"><view class="litter-count"><input type="number" data-key="litter" value="{{form.litter}}" placeholder="例如1次" aria-label="排便次数" bindinput="onRecordInput" /></view><view class="litter-shape"><input data-key="litterShape" value="{{form.litterShape}}" maxlength="60" placeholder="软, 硬, 血便, 毛球等" aria-label="便便形态，选填，默认正常" bindinput="onRecordInput" /></view></view><input wx:else type="digit" data-key="{{item.key}}" value="{{form[item.key]}}" placeholder="{{item.key === 'water' ? '例如 50' : '例如 20'}}" bindinput="onRecordInput" /></view>
<text class="caption">记录保存在当前设备。</text><button class="primary-button" bindtap="saveRecord">保存本次记录</button></view>
