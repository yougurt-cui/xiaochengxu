<view class="page">
  <page-header title="宠物管家" />
  <view class="content {{!recognized ? 'initial-content' : ''}}">
    <view wx:if="{{savedMode}}" class="saved-card">
        <view class="saved-head">
          <view class="saved-icon">▧</view>
          <text>上次未完成的换粮对话</text>
          <text class="autosave">已自动保存</text>
          <view class="delete-saved" catchtap="deleteSavedConversation">删除</view>
        </view>
        <view class="saved-title">{{savedDraft.userMessage || '上次换粮对话'}} <text>›</text></view>
        <view class="saved-detail">当前粮：{{savedDraft.currentFood.brand}} {{savedDraft.currentFood.name}}　·　目标粮：{{savedDraft.targetFood.brand}} {{savedDraft.targetFood.name}}</view>
        <view class="saved-time">最近自动保存</view>
        <button class="continue-button" data-action="resume" bindtap="continueConversation">继续对话　›</button>
      </view>

    <view wx:if="{{!chatMessages.length}}" class="chat-welcome"><view class="welcome-card"><view class="welcome-row"><view class="bot-mark"><p-icon name="ai-search" tone="primary" size="60" /></view><view class="welcome-copy"><view class="welcome-heading"><text class="welcome-title">嗨，我是你的宠物管家</text><button class="welcome-history" bindtap="openConversationHistory"><p-icon name="history" tone="primary" size="24" />对话记录</button></view><text class="welcome-subtitle">今天想聊点什么？</text></view></view><text class="welcome-description">聊聊饮食与状态，养宠的小问题一起理清。</text></view><view class="quick-prompts"><button data-message="三岁英短最近软便，正在吃皇家肠胃舒适，想换鲜朗" bindtap="usePrompt"><p-icon name="cat" size="32" />最近软便，想了解换粮的注意事项<text>↗</text></button><button data-message="我想换低敏粮，需要提供哪些信息？" bindtap="usePrompt"><p-icon name="food" size="32" />想换低敏粮，从哪里开始？<text>↗</text></button><button bindtap="openIngredientSheet"><p-icon name="image" size="32" />分析配料表<text>↗</text></button></view><text class="ai-reply-note">消息回复由AI人工智能生成</text></view>
    <view wx:if="{{chatMessages.length}}" class="active-chat-toolbar"><text>宠物管家 · 换粮咨询</text><button class="text-button" bindtap="openConversationHistory"><p-icon name="history" size="26" />对话记录</button></view><view class="conversation-thread"><view wx:for="{{chatMessages}}" wx:key="id" class="thread-message {{item.role}}"><view wx:if="{{item.role === 'assistant'}}" class="assistant-label"><view class="reply-avatar"><p-icon name="cat" tone="accentText" size="32" /></view><text>宠物管家</text></view><view wx:if="{{item.images && item.images.length}}" class="message-images"><image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="message-image" src="{{img}}" mode="aspectFill" data-current="{{img}}" bindtap="previewComposerImage" /></view><text selectable>{{item.text}}</text><button wx:if="{{item.error}}" class="retry-button" bindtap="retryMessage">重新发送</button></view><view wx:if="{{sending}}" class="loading-message"><view class="typing-dot"></view><view class="typing-dot"></view><view class="typing-dot"></view><text>正在整理你的问题</text></view></view>
    <view wx:if="{{recognized}}" class="ready-block">
      <p-icon name="cat" size="48" />
      <text class="ready-title">我已整理好你的换粮信息</text>
      <text class="ready-subtitle">请确认后开始分析</text>
    </view>

    <view wx:if="{{recognized}}" class="confirm-card">
      <view class="confirm-head">
        <text class="confirm-heading">换粮信息</text>
        <view class="modify" bindtap="focusComposer">⌕ 修改</view>
      </view>
      <view class="info-list">
        <view class="info-row" data-type="current" bindtap="openFoodSheet">
          <view class="row-icon pink">♙</view>
          <text class="label">当前粮</text>
          <text class="value">{{currentFood.brand}} {{currentFood.name}}</text>
          <text class="chevron">›</text>
        </view>
        <view class="info-row" data-type="target" bindtap="openFoodSheet">
          <view class="row-icon green">⌁</view>
          <text class="label">目标粮</text>
          <text class="value">{{targetFood.brand}} {{targetFood.name}}</text>
          <text class="chevron">›</text>
        </view>
        <view class="info-row" bindtap="openSymptoms">
          <view class="row-icon yellow"><p-icon name="cat" tone="accentText" /></view>
          <text class="label">猫咪状态</text>
          <text class="value symptom">{{symptomText}}</text>
          <text class="chevron">›</text>
        </view>
      </view>
      <button class="primary-action" loading="{{testing}}" bindtap="startTest">{{testing ? '正在分析...' : '开始换粮分析'}}</button>
    </view>
  </view>

  <view wx:if="{{showExitModal}}" class="exit-mask" bindtap="continueConversation"></view>
  <view wx:if="{{showExitModal}}" class="exit-modal">
    <p-icon name="cat" size="64" />
    <text class="exit-title">退出当前对话？</text>
    <text class="exit-desc">本次换粮信息会自动保存，下次可继续
补充和分析。</text>
    <view class="exit-summary">已识别：当前粮、目标粮、猫咪状态</view>
    <button class="leave-button" bindtap="directLeave">直接离开</button>
    <button class="stay-button" bindtap="continueConversation">继续对话</button>
  </view>

  <view wx:if="{{showFoodSheet || showSymptomSheet || showIngredientSheet}}" class="mask" bindtap="closeSheet"></view>
  <view wx:if="{{showFoodSheet}}" class="sheet {{showFoodSheet ? 'open' : ''}}">
    <view class="sheet-head"><text>{{foodTitle}}</text><text bindtap="closeSheet">×</text></view>
    <view wx:if="{{loadingFoods}}" class="food-loading">正在加载该品牌的产品…</view>
    <view wx:for="{{foodOptions}}" wx:key="id" class="food-option" data-id="{{item.id}}" bindtap="chooseFood"><view class="option-image">{{item.emoji}}</view><view><text class="option-brand">{{item.brand}}</text><text class="option-name">{{item.name}}</text></view><text class="check">{{item.selected ? '✓' : ''}}</text></view>
    <view wx:if="{{!loadingFoods && !foodOptions.length}}" class="food-loading">该品牌暂无可选择的产品</view>
  </view>
  <view wx:if="{{showSymptomSheet}}" class="sheet {{showSymptomSheet ? 'open' : ''}}">
    <view class="sheet-head"><text>编辑猫咪状态</text><text bindtap="closeSheet">×</text></view>
    <view class="symptom-grid"><view wx:for="{{symptomOptions}}" wx:key="label" class="chip {{item.selected ? 'selected' : ''}}" data-label="{{item.label}}" bindtap="toggleSymptom">{{item.selected ? '✓ ' : ''}}{{item.label}}</view></view>
    <button class="confirm" bindtap="confirmSymptoms">确认</button>
  </view>
  <view wx:if="{{showIngredientSheet}}" class="sheet open ingredient-sheet">
    <view class="sheet-head"><text>拍摄示例</text><text bindtap="closeSheet">×</text></view>
    <view class="ingredient-sample" bindtap="previewIngredientExample">
      <image class="ingredient-sample-image" src="/static/assistant/ingredient-example.jpg" mode="aspectFill" />
      <text class="ingredient-sample-tip">必须同时包含完整配料表和营养成分保证值；若在不同包装面，请分别拍摄并一起上传。</text>
    </view>
    <text class="ingredient-format-hint">支持 1~3 张 JPG、PNG、WEBP，单张不超过 10MB</text>
    <button class="ingredient-found-button" bindtap="onIngredientFound">选择或拍照</button>
  </view>
<view wx:if="{{!showFoodSheet && !showSymptomSheet && !showIngredientSheet && !showExitModal && !historyVisible}}" class="chat-input-dock" style="{{keyboardHeight ? 'bottom:' + keyboardHeight + 'px' : ''}}"><view class="chat-input-box"><view wx:if="{{composerImages.length}}" class="composer-images"><view wx:for="{{composerImages}}" wx:key="*this" class="composer-image" data-current="{{item}}" bindtap="previewComposerImage"><image src="{{item}}" mode="aspectFill" /><button class="composer-image-remove" data-index="{{index}}" catchtap="removeComposerImage" aria-label="移除图片"><p-icon name="close" tone="inverse" size="20" /></button></view></view><textarea class="chat-textarea" focus="{{composerFocused}}" bindblur="blurComposer" value="{{inputMessage}}" placeholder="当前粮和目标想换的粮是什么？猫咪现在状态如何？" maxlength="4000" fixed adjust-position="{{false}}" cursor-spacing="20" show-confirm-bar="{{false}}" confirm-type="send" bindinput="onMessageInput" bindconfirm="sendMessage" bindkeyboardheightchange="onKeyboardChange" /><view class="input-actions"><text>换粮咨询</text><button wx:if="{{sending}}" class="send-button" bindtap="stopSending" aria-label="停止生成"><p-icon name="stop" tone="inverse" size="26" /></button><button wx:else class="send-button" disabled="{{!(inputMessage || composerImages.length)}}" bindtap="sendMessage" aria-label="发送"><p-icon name="up" tone="inverse" size="28" /></button></view></view><view class="chat-disclaimer">AI 内容仅供参考，不能替代兽医诊断</view></view>
<view wx:if="{{historyVisible}}" class="sheet-mask" bindtap="closeHistory"></view><view wx:if="{{historyVisible}}" class="bottom-sheet"><view class="sheet-heading"><text>对话记录</text><button bindtap="closeHistory" aria-label="关闭"><p-icon name="close" /></button></view><button wx:for="{{conversations}}" wx:key="id" class="menu-row" data-id="{{item.id}}" bindtap="restoreConversation"><p-icon name="chat" /><view class="row-copy">{{item.title}}</view><text>›</text></button><view wx:if="{{!conversations.length}}" class="empty-state">从第一句开始，对话会保存在当前设备。</view><button class="primary-button" bindtap="newConversation">开启新对话</button></view>
</view>
