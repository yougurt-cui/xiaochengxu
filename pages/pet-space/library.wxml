<view class="page {{mode === 'posts' ? 'has-page-actions' : ''}}"><page-header title="{{title}}" back /><view class="screen-body"><text class="caption">{{mode === 'favorites' ? '把有帮助的经验，留在随时找得到的地方。' : '记录它的日常，也留下你的养宠经验。'}}</text><view wx:if="{{mode === 'posts'}}" class="category-tabs library-tabs"><button class="category-tab {{filter === 'published' ? 'active' : ''}}" data-id="published" bindtap="selectFilter">已发布</button><button class="category-tab {{filter === 'draft' ? 'active' : ''}}" data-id="draft" bindtap="selectFilter">草稿</button></view><view wx:if="{{loading}}" class="empty-state">正在同步帖子…</view><view wx:if="{{error}}" class="empty-state">{{error}}<button class="text-button" bindtap="reload">重新加载</button></view><view class="library-feed"><post-feed posts="{{posts}}" bind:open="openPost" bind:save="toggleSave" allow-save="{{filter !== 'draft' || mode === 'favorites'}}" /></view><view wx:if="{{!posts.length && !loading && !error}}" class="empty-state"><p-icon name="{{mode === 'favorites' ? 'save' : 'post'}}" size="72" /><text class="empty-title">{{mode === 'favorites' ? '还没有收藏的经验' : filter === 'draft' ? '还没有未完成的记录' : '从第一篇记录开始'}}</text><text>{{mode === 'favorites' ? '在状态页轻点收藏，就能在这里回看。' : '你的帖子与草稿会收在这里。'}}</text></view></view></view>

<view wx:if="{{mode === 'posts'}}" class="page-action-footer"><button wx:if="{{mode === 'posts'}}" class="primary-button" bindtap="writePost">写个帖子</button></view>
