<view class="page"><page-header title="{{form.id ? '编辑宠物档案' : '添加宠物'}}" back /><view class="screen-body"><button class="recognition-card" bindtap="recognize" disabled="{{recognizing || saving || loading}}"><p-image wx:if="{{photo || form.image}}" image-class="recognition-photo" src="{{photo || form.image}}" mode="aspectFill" /><view wx:else class="recognition-icon"><p-icon name="image" size="48" /></view><view class="recognition-copy"><view class="recognition-title">{{recognizing ? '正在识别…' : 'AI 拍照识别'}}</view><text class="caption">拍照或选择照片，识别后核对保存</text></view><p-icon name="arrow" size="26" /></button><view wx:if="{{recognitionNote}}" class="recognition-notice">{{recognitionNote}}</view><text wx:else class="caption recognition-note">照片将上传用于识别，并在保存档案后作为头像。</text><view wx:if="{{loading}}" class="empty-state">正在读取档案…</view><view wx:if="{{error}}" class="recognition-notice">{{error}}<button class="text-button" bindtap="loadPet">重试</button></view><view class="pet-form"><view class="form-field"><text>宠物昵称</text><input value="{{form.name}}" data-key="name" bindinput="input" maxlength="12" placeholder="它叫什么名字？" disabled="{{loading || saving || recognizing}}" /></view><view class="field-pair"><view class="form-field"><text>类型</text><picker range="{{animalTypes}}" value="{{form.animal_type === 'dog' ? 1 : form.animal_type === 'unknown' ? 2 : 0}}" bindchange="changeType" disabled="{{loading || saving || recognizing}}"><view class="form-value">{{form.type}}<p-icon name="arrow" size="24" /></view></picker></view><view class="form-field"><text>品种</text><input value="{{form.breed}}" data-key="breed" bindinput="input" maxlength="24" placeholder="如：英国短毛猫" disabled="{{loading || saving || recognizing}}" /></view></view><view class="field-pair"><view class="form-field"><text>年龄 <text class="caption">岁</text></text><input type="digit" value="{{form.age}}" data-key="age" bindinput="input" maxlength="4" placeholder="如 2.5" disabled="{{loading || saving || recognizing}}" /></view><view class="form-field"><text>体重 <text class="caption">kg</text></text><input type="digit" value="{{form.weight}}" data-key="weight" bindinput="input" maxlength="5" placeholder="如 4.5" disabled="{{loading || saving || recognizing}}" /></view></view><view class="field-pair"><view class="form-field"><text>口粮品牌（选填）</text><input value="{{form.food_brand}}" data-key="food_brand" bindinput="input" maxlength="128" disabled="{{saving || loading || recognizing}}" placeholder="如：皇家" /></view><view class="form-field"><text>产品 / 系列（选填）</text><input value="{{form.food_product}}" data-key="food_product" bindinput="input" maxlength="512" disabled="{{saving || loading || recognizing}}" placeholder="当前正在吃的粮" /></view></view><view class="form-field"><text>补充信息（选填）</text><textarea value="{{form.notes}}" data-key="notes" bindinput="input" maxlength="1000" disabled="{{saving || loading || recognizing}}" placeholder="它的喜好、过敏或其他需要管家了解的信息" /></view></view><text class="caption">识别建议可修改，年龄与体重请按实际情况填写。</text><button class="primary-button" bindtap="save" loading="{{saving}}" disabled="{{saving || recognizing || loading || error}}">保存档案</button></view></view>
