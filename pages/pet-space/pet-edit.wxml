<view class="page"><page-header title="{{form.id ? '编辑宠物档案' : '添加宠物'}}" back /><view class="screen-body"><button class="recognition-card" bindtap="recognize" disabled="{{recognizing || saving || loading}}"><p-image wx:if="{{photo || form.image}}" image-class="recognition-photo" src="{{photo || form.image}}" mode="aspectFill" /><view wx:else class="recognition-icon"><p-icon name="image" size="48" /></view><view class="recognition-copy"><view class="recognition-title">{{recognizing ? '正在识别…' : 'AI 拍照识别'}}</view><text class="caption">拍照或选择照片，识别后核对保存</text></view><p-icon name="arrow" size="26" /></button><view wx:if="{{recognitionNote}}" class="recognition-notice">{{recognitionNote}}</view><text wx:else class="caption recognition-note">照片将上传用于识别，并在保存档案后作为头像。</text><view wx:if="{{loading}}" class="empty-state">正在读取档案…</view><view wx:if="{{error}}" class="recognition-notice">{{error}}<button class="text-button" bindtap="loadPet">重试</button></view><view class="pet-form"><view class="form-field"><text>名称</text><input type="text" value="{{form.name}}" data-key="name" bindinput="input" maxlength="64" placeholder="它叫什么名字？" disabled="{{loading || saving || recognizing}}" /></view><view class="field-pair"><view class="form-field"><text>类型</text><picker range="{{animalTypes}}" value="{{form.animal_type === 'dog' ? 1 : form.animal_type === 'unknown' ? 2 : 0}}" bindchange="changeType" disabled="{{loading || saving || recognizing}}"><view class="form-value">{{form.type}}<p-icon name="arrow" size="24" /></view></picker></view><view class="form-field"><text>品种</text><input type="text" value="{{form.breed}}" data-key="breed" bindinput="input" maxlength="64" placeholder="如：英国短毛猫" disabled="{{loading || saving || recognizing}}" /></view></view><view class="field-pair"><view class="form-field"><text>公母</text><picker range="{{sexes}}" value="{{form.sex === 'male' ? 1 : form.sex === 'female' ? 2 : 0}}" bindchange="changeSex" disabled="{{loading || saving || recognizing}}"><view class="form-value">{{form.sex === 'male' ? '公' : form.sex === 'female' ? '母' : '未知'}}<p-icon name="arrow" size="24" /></view></picker></view><view class="form-field"><text>是否绝育</text><picker range="{{neuterOptions}}" value="{{form.neutered === true ? 2 : form.neutered === false ? 1 : 0}}" bindchange="changeNeutered" disabled="{{loading || saving || recognizing}}"><view class="form-value">{{form.neutered === true ? '已绝育' : form.neutered === false ? '未绝育' : '未填写'}}<p-icon name="arrow" size="24" /></view></picker></view></view>
<view wx:if="{{false}}" class="optional-card"><view class="optional-heading"><text>多了解它一点</text><text class="caption">选填 · {{step < 8 ? step + 1 : 8}} / 8</text></view>
<scroll-view scroll-x class="step-tabs"><view class="step-tab-row"><button size="mini" wx:for="{{steps}}" wx:key="*this" class="step-tab {{step === index ? 'active' : ''}}" data-index="{{index}}" bindtap="chooseStep" disabled="{{loading || saving || recognizing}}">{{item}}</button></view></scroll-view>
<view class="step-content">
<view wx:if="{{step === 0}}" class="form-field"><picker aria-label="生日" mode="date" end="{{today}}" value="{{form.birthday || today}}" bindchange="changeBirthday" disabled="{{loading || saving || recognizing}}"><view class="form-value">{{form.birthday || '选择它的生日'}}<p-icon name="arrow" size="24" /></view></picker><text class="age-hint caption">{{form.birthday ? '现在 ' + form.age_text + ' · ' + form.age_months + ' 个月' : '填写后自动计算年龄，不确定可以先跳过。'}}</text><button size="mini" wx:if="{{form.birthday}}" class="text-button" bindtap="clearBirthday" disabled="{{loading || saving || recognizing}}">清除生日</button></view>
<view wx:elif="{{step === 1}}" class="form-field"><input type="digit" value="{{form.weight}}" data-key="weight" bindinput="input" maxlength="5" placeholder="体重，如 4.5 kg" aria-label="体重（kg）" disabled="{{loading || saving || recognizing}}" /></view>
<view wx:elif="{{step === 2}}" class="form-field"><view class="allergy-options"><button size="mini" class="allergy-option {{form.allergyChoice === 'unknown' ? 'active' : ''}}" data-value="unknown" bindtap="chooseAllergy" disabled="{{loading || saving || recognizing}}">不确定</button><button size="mini" class="allergy-option {{form.allergyChoice === 'no' ? 'active' : ''}}" data-value="no" bindtap="chooseAllergy" disabled="{{loading || saving || recognizing}}">无已知过敏</button><button size="mini" class="allergy-option {{form.allergyChoice === 'yes' ? 'active' : ''}}" data-value="yes" bindtap="chooseAllergy" disabled="{{loading || saving || recognizing}}">有过敏</button></view><view wx:if="{{form.allergyChoice === 'yes'}}"><input type="text" value="{{form.allergiesText}}" data-key="allergiesText" bindinput="input" maxlength="1000" placeholder="如：鸡肉、乳制品" disabled="{{loading || saving || recognizing}}" /></view></view><view wx:elif="{{step === 3}}" class="form-field"><input type="text" value="{{form.diseasesText}}" data-key="diseasesText" bindinput="input" maxlength="1000" placeholder="如：曾有泌尿系统疾病，无则可跳过" disabled="{{loading || saving || recognizing}}" /><text class="caption age-hint">多项可用顿号或逗号分隔</text></view><view wx:elif="{{step === 4}}" class="form-field"><input type="text" value="{{form.symptomsText}}" data-key="symptomsText" bindinput="input" maxlength="1000" placeholder="如：软便、食欲下降" disabled="{{loading || saving || recognizing}}" /><text class="caption age-hint">多项可用顿号或逗号分隔</text></view><view wx:elif="{{step === 5}}" class="form-field"><input type="text" value="{{form.health_statusText}}" data-key="health_statusText" bindinput="input" maxlength="1000" placeholder="如：精神良好、恢复期" disabled="{{loading || saving || recognizing}}" /><text class="caption age-hint">多项可用顿号或逗号分隔</text></view><view wx:elif="{{step === 6}}" class="field-pair"><view class="form-field"><text>口粮品牌</text><input type="text" value="{{form.food_brand}}" data-key="food_brand" bindinput="input" maxlength="128" placeholder="如：皇家" disabled="{{loading || saving || recognizing}}" /></view><view class="form-field"><text>产品 / 系列</text><input type="text" value="{{form.food_product}}" data-key="food_product" bindinput="input" maxlength="512" placeholder="当前正在吃的粮" disabled="{{loading || saving || recognizing}}" /></view></view><view wx:elif="{{step === 7}}" class="form-field"><textarea value="{{form.notes}}" data-key="notes" bindinput="input" maxlength="1000" placeholder="补充它的习惯、喜好或注意事项…" disabled="{{loading || saving || recognizing}}" /></view><view wx:else class="step-complete">选填资料已浏览完毕<text class="caption">可点击上方步骤继续修改，确认后保存档案。</text></view></view><view wx:if="{{step < 8}}" class="step-actions"><button size="mini" class="text-button" bindtap="nextStep" disabled="{{loading || saving || recognizing}}">跳过</button><view class="step-right"><button size="mini" wx:if="{{step > 0}}" class="text-button" bindtap="previousStep" disabled="{{loading || saving || recognizing}}">上一步</button><button size="mini" class="step-next" bindtap="nextStep" disabled="{{loading || saving || recognizing}}">{{step === 7 ? '完成' : '下一个'}}</button></view></view></view></view></view><view class="page-action-footer"><button class="primary-button" bindtap="save" loading="{{saving}}" disabled="{{saving || recognizing || loading || error}}">保存档案</button></view></view>