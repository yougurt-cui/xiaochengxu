<view class="page {{!hasPet ? 'needs-pet' : ''}}">
  <page-header title="{{title}}" back />
  <view class="screen-body">
    <swiper
      class="hero-swiper"
      current="{{slide}}"
      bindchange="changeSlide"
      circular
      indicator-dots
      indicator-color="rgba(255,255,255,.4)"
      indicator-active-color="#ffffff"
    >
      <swiper-item wx:for="{{slides}}" wx:key="id">
        <view class="hero-slide">
          <p-image image-class="hero-image" src="{{item.image}}" mode="aspectFill" />
          <view class="hero-shade"></view>
          <view class="hero-copy">
            <text class="hero-kicker">{{kind === 'toys' ? 'PLAY & LOVE' : 'EAT & LOVE'}}</text>
            <text class="hero-title">{{item.title}}</text>
            <text class="hero-subtitle">{{item.subtitle}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="section-heading">
      <text>我的清单 <text wx:if="{{mine.length > 0}}" class="count">{{mine.length}}</text></text>
      <button class="text-button" bindtap="editMine"><p-icon name="plus" size="26" />添加</button>
    </view>
    <view wx:if="{{!mine.length}}" class="local-empty">
      {{kind === 'toys' ? '它喜欢的玩具，在这里慢慢收集。' : '正在吃的粮和喜欢的口味，都记在这里。'}}
    </view>
    <button wx:for="{{mine}}" wx:key="id" class="mine-card" data-id="{{item.id}}" bindtap="editMine">
      <view class="mine-icon"><p-icon name="{{kind === 'toys' ? 'toy' : 'food'}}" /></view>
      <view class="mine-copy">
        <text class="card-title">{{item.name}}</text>
        <text class="card-note">{{item.note || '轻点补充使用记录'}}</text>
      </view>
      <p-icon name="arrow" size="26" tone="muted" />
    </button>
    <text class="caption">清单保存在当前设备</text>

    <view class="section-heading">
      <text>{{kind === 'toys' ? '创意好物' : '食品目录'}}</text>
      <button wx:if="{{kind === 'food'}}" class="text-button catalog-action" bindtap="openCatalogAdd">打猎</button>
      <text wx:else>来自周边创意</text>
    </view>

    <view wx:if="{{kind === 'food'}}" class="catalog-search">
      <input
        value="{{brand}}"
        data-key="brand"
        bindinput="inputSearch"
        placeholder="品牌，如皇家"
        confirm-type="search"
        bindconfirm="loadCatalog"
      />
      <input
        value="{{query}}"
        data-key="query"
        bindinput="inputSearch"
        placeholder="系列 / 产品（选填）"
        confirm-type="search"
        bindconfirm="loadCatalog"
      />
      <button bindtap="loadCatalog">查询</button>
    </view>

    <view wx:if="{{loading}}" class="empty-state">正在加载{{kind === 'toys' ? '创意好物' : '食品目录'}}…</view>
    <view wx:if="{{error}}" class="empty-state">
      {{error}}
      <button class="text-button" bindtap="loadCatalog">重新加载</button>
    </view>

    <view class="catalog-grid">
      <button wx:for="{{items}}" wx:key="id" class="catalog-card" data-id="{{item.id}}" bindtap="openItem">
        <view class="catalog-media">
          <p-image wx:if="{{item.image}}" image-class="catalog-image" src="{{item.image}}" mode="aspectFill" />
          <view wx:else class="catalog-placeholder {{kind}}">
            <p-icon
              name="{{kind === 'toys' ? 'toy' : 'food'}}"
              size="80"
              tone="{{kind === 'food' ? 'accentText' : 'primary'}}"
            />
          </view>
          <text wx:if="{{kind === 'food' && item.brand}}" class="catalog-brand">{{item.brand}}</text>
        </view>
        <view class="catalog-copy">
          <text wx:if="{{kind === 'toys'}}" class="card-tag">{{item.tag}}</text>
          <text class="card-title">{{item.name}}</text>
          <text class="card-note">{{kind === 'food' ? item.displayText : item.note}}</text>
        </view>
      </button>
    </view>

    <view wx:if="{{!loading && !error && !items.length}}" class="empty-state catalog-empty">
      <text>
        {{kind === 'toys' ? '更多创意正在准备中，也可以先添加自己的玩具。' : '暂未收录相关商品，试试其他品牌或手动添加'}}
      </text>
      <button wx:if="{{kind === 'food'}}" class="catalog-empty-button" bindtap="openCatalogAdd">手动添加</button>
    </view>
  </view>
</view>

<view wx:if="{{!hasPet && !selected && !editing && !catalogAdding}}" class="add-pet-footer">
  <button class="primary-button" bindtap="addPet"><p-icon name="plus" tone="inverse" size="30" />添加爱宠</button>
</view>

<view
  wx:if="{{selected || editing || catalogAdding}}"
  class="sheet-mask"
  bindtap="{{catalogAdding ? 'closeCatalogAdd' : editing ? 'closeEditor' : 'closeDetail'}}"
></view>

<view wx:if="{{selected}}" class="bottom-sheet">
  <view class="sheet-heading">
    <text>{{kind === 'food' ? '食品详情' : '好物详情'}}</text>
    <button bindtap="closeDetail" aria-label="关闭"><p-icon name="close" /></button>
  </view>
  <p-image wx:if="{{selected.image}}" image-class="detail-image" src="{{selected.image}}" mode="widthFix" />
  <view wx:else class="detail-placeholder {{kind}}">
    <p-icon name="{{kind === 'toys' ? 'toy' : 'food'}}" size="96" tone="{{kind === 'food' ? 'accentText' : 'primary'}}" />
  </view>
  <text wx:if="{{selected.brand || selected.tag}}" class="tag">{{selected.brand || selected.tag}}</text>
  <view class="section-heading detail-title">{{selected.name}}</view>
  <text wx:if="{{kind === 'food' && selected.originType}}" class="detail-meta">{{selected.originType}}</text>
  <text class="detail-note">{{kind === 'food' ? selected.displayText : selected.note}}</text>
  <button class="primary-button" bindtap="addToMine">加入{{title}}</button>
</view>

<view wx:if="{{catalogAdding}}" class="bottom-sheet">
  <block wx:if="{{catalogEditorMode === 'ingredient'}}">
    <view class="sheet-heading">
      <text>拍摄示例</text>
      <button bindtap="closeCatalogIngredient" aria-label="返回"><p-icon name="close" /></button>
    </view>
    <view class="ingredient-sheet">
      <view class="ingredient-sample" bindtap="previewIngredientExample">
        <image
          class="ingredient-sample-image"
          src="/pages/pet-space/static/ingredient-example.jpg"
          mode="aspectFill"
        />
        <text class="ingredient-sample-tip">
          必须同时包含完整配料表和营养成分保证值；若在不同包装面，请分别拍摄并一起上传。
        </text>
      </view>
      <text class="ingredient-format-hint">支持 1~3 张 JPG、PNG、WEBP，单张不超过 10MB</text>
      <button class="ingredient-found-button" bindtap="onCatalogIngredientFound">选择或拍照</button>
    </view>
  </block>
  <block wx:else>
    <view class="sheet-heading">
      <text>新增食品</text>
      <button bindtap="closeCatalogAdd" aria-label="关闭"><p-icon name="close" /></button>
    </view>
    <view class="form-field">
      <text>品牌</text>
      <input value="{{catalogForm.brand}}" data-key="brand" bindinput="inputCatalog" maxlength="40" placeholder="如皇家、渴望" />
    </view>
    <view class="form-field">
      <text>系列</text>
      <input
        value="{{catalogForm.series}}"
        data-key="series"
        bindinput="inputCatalog"
        maxlength="60"
        placeholder="如 BK34、肠道舒适"
      />
    </view>
    <view class="ingredient-entry" bindtap="openCatalogIngredient">
      <view class="ingredient-entry-icon"><p-icon name="image" size="36" /></view>
      <view class="ingredient-entry-copy">
        <text class="ingredient-entry-title">上传图片分析配方</text>
        <text class="caption">暂无解析接口，图片会先保存在本机目录</text>
      </view>
      <text class="ingredient-entry-arrow">↗</text>
    </view>
    <view wx:if="{{catalogForm.images.length}}" class="form-images">
      <view
        wx:for="{{catalogForm.images}}"
        wx:key="*this"
        class="form-image"
        data-current="{{item}}"
        bindtap="previewCatalogImage"
      >
        <image src="{{item}}" mode="aspectFill" />
        <button class="form-image-remove" data-index="{{index}}" catchtap="removeCatalogImage" aria-label="移除图片">
          <p-icon name="close" tone="inverse" size="20" />
        </button>
      </view>
    </view>
    <button class="primary-button" bindtap="saveCatalogFood">保存到食品目录</button>
  </block>
</view>

<view wx:if="{{editing}}" class="bottom-sheet">
  <block wx:if="{{editorMode === 'ingredient'}}">
    <view class="sheet-heading">
      <text>拍摄示例</text>
      <button bindtap="closeIngredientSheet" aria-label="返回"><p-icon name="close" /></button>
    </view>
    <view class="ingredient-sheet">
      <view class="ingredient-sample" bindtap="previewIngredientExample">
        <image
          class="ingredient-sample-image"
          src="/pages/pet-space/static/ingredient-example.jpg"
          mode="aspectFill"
        />
        <text class="ingredient-sample-tip">
          必须同时包含完整配料表和营养成分保证值；若在不同包装面，请分别拍摄并一起上传。
        </text>
      </view>
      <text class="ingredient-format-hint">支持 1~3 张 JPG、PNG、WEBP，单张不超过 10MB</text>
      <button class="ingredient-found-button" bindtap="onIngredientFound">选择或拍照</button>
    </view>
  </block>
  <block wx:else>
    <view class="sheet-heading">
      <text>{{editingId ? '编辑记录' : '添加记录'}}</text>
      <button bindtap="closeEditor" aria-label="关闭"><p-icon name="close" /></button>
    </view>
    <view wx:if="{{kind === 'food'}}" class="ingredient-entry" bindtap="openIngredientSheet">
      <view class="ingredient-entry-icon"><p-icon name="image" size="36" /></view>
      <view class="ingredient-entry-copy">
        <text class="ingredient-entry-title">分析配料表</text>
        <text class="caption">拍照或上传配料表，辅助添加食物记录</text>
      </view>
      <text class="ingredient-entry-arrow">↗</text>
    </view>
    <view wx:if="{{kind === 'food' && form.images.length}}" class="form-images">
      <view
        wx:for="{{form.images}}"
        wx:key="*this"
        class="form-image"
        data-current="{{item}}"
        bindtap="previewFormImage"
      >
        <image src="{{item}}" mode="aspectFill" />
        <button class="form-image-remove" data-index="{{index}}" catchtap="removeFormImage" aria-label="移除图片">
          <p-icon name="close" tone="inverse" size="20" />
        </button>
      </view>
    </view>
    <view class="form-field">
      <text>名称</text>
      <input
        value="{{form.name}}"
        data-key="name"
        bindinput="input"
        maxlength="100"
        placeholder="{{kind === 'food' ? '填写食品名称' : '填写玩具或食品名称'}}"
      />
    </view>
    <view class="form-field">
      <text>使用记录</text>
      <textarea
        value="{{form.note}}"
        data-key="note"
        bindinput="input"
        maxlength="300"
        placeholder="记录它的喜好、口味或使用感受…"
      />
    </view>
    <button class="primary-button" bindtap="saveMine">保存记录</button>
  </block>
</view>
