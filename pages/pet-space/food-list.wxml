<view class="page {{!history ? 'has-page-actions' : ''}}"><page-header title="{{history ? '历史口粮' : '口粮清单'}}" back /><view class="screen-body">
<view class="section-heading">{{pet ? pet.name + '的' + (history ? '历史口粮' : '清单') : ''}}</view>
<text wx:if="{{history}}" class="caption">历史仅保存在当前设备，从启用记录后开始积累；日期为记录变更时间。</text>
<view wx:if="{{loading}}" class="empty-state">正在读取…</view><view wx:elif="{{error}}" class="empty-state">{{error}}<button class="text-button" bindtap="load">重试</button></view>
<block wx:else><view wx:if="{{!items.length}}" class="empty-state">{{history ? '还没有历史口粮，更换口粮后会自动记录。' : '还没有口粮，点击底部按钮添加。'}}</view><view wx:for="{{items}}" wx:key="id" class="diet-list-card"><view class="diet-icon"><p-icon name="food" /></view><view class="diet-copy"><text class="diet-name">{{item.brand}} · {{item.product}}</text><text class="caption">{{history ? item.date + ' 记录变更' : '当前口粮'}}</text></view><button wx:if="{{!history}}" class="text-button" bindtap="edit" aria-label="编辑口粮"><p-icon name="edit" size="30" /></button></view></block>
</view></view>
<view wx:if="{{!history && !editing && pet && !error}}" class="page-action-footer"><button class="primary-button" bindtap="edit" disabled="{{loading}}">{{items.length ? '更换口粮' : '添加口粮'}}</button></view>
<view wx:if="{{editing}}" class="sheet-mask" bindtap="close"></view><view wx:if="{{editing}}" class="bottom-sheet"><view class="sheet-heading"><text>{{pet.name}}的口粮</text><button bindtap="close" disabled="{{saving}}"><p-icon name="close" /></button></view><view class="form-field"><text>品牌</text><input value="{{form.brand}}" data-key="brand" bindinput="input" maxlength="128" disabled="{{saving}}" placeholder="如：皇家" /></view><view class="form-field"><text>系列</text><input value="{{form.product}}" data-key="product" bindinput="input" maxlength="512" disabled="{{saving}}" placeholder="如：FIT32" /></view><button class="primary-button" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存口粮</button></view>
