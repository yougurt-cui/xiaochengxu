<template name="reminder-card"><view class="reminder-card"><button class="reminder-card-title" bindtap="edit" data-id="{{item.id}}"><view class="reminder-icon"><p-icon name="{{item.icon}}" size="38" /></view><text>{{item.title}}</text><p-icon name="arrow" size="24" tone="muted" /></button><view class="reminder-line"><text class="caption">时间</text><text class="{{item.overdue ? 'overdue-text' : ''}}">{{item.dueText}}</text><text wx:if="{{item.overdue}}" class="overdue-tag">{{item.overdueText}}</text></view><view class="reminder-line"><text class="caption">重复</text><text>{{item.repeatText}}</text></view><view class="reminder-card-bottom"><text class="pet-label">{{item.petName || '未关联宠物'}}</text><button size="mini" class="complete-button" bindtap="complete" data-id="{{item.id}}" data-due="{{item.dueAt}}"><p-icon name="check" size="24" />标记完成</button></view></view></template>
<view class="page {{history ? '' : 'has-page-actions'}}"><page-header title="{{history ? '历史记录' : '我的提醒'}}" back /><view class="screen-body">
<block wx:if="{{!history}}"><view class="reminder-intro"><text class="caption">把照顾它的小事，记在这里</text><button class="text-button" bindtap="history"><p-icon name="history" size="26" />历史记录</button></view><text class="caption local-note">仅保存在当前设备，暂不发送系统通知</text><view wx:if="{{!overdue.length && !upcoming.length}}" class="empty-state"><p-icon name="bell" size="64" /><text>还没有提醒，先记下一件小事吧</text></view><view wx:if="{{overdue.length}}" class="section-heading">逾期提醒</view><template wx:for="{{overdue}}" wx:key="id" is="reminder-card" data="{{item}}" /><view wx:if="{{upcoming.length}}" class="section-heading">待办提醒</view><template wx:for="{{upcoming}}" wx:key="id" is="reminder-card" data="{{item}}" /></block>
<block wx:else><scroll-view scroll-x class="reminder-filter-scroll"><view class="reminder-filters"><button wx:for="{{filters}}" wx:key="id" size="mini" class="filter-chip {{filter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseFilter">{{item.name}}</button></view></scroll-view><view wx:if="{{!records.length}}" class="empty-state">完成提醒后，记录会出现在这里</view><button wx:for="{{records}}" wx:key="id" class="history-row" bindtap="detail" data-id="{{item.id}}"><view class="history-copy"><text class="reminder-name">{{item.title}}</text><text>{{item.completedText}}</text><text class="caption">{{item.petName || '未关联宠物'}}</text></view><text class="caption">已完成</text><p-icon name="arrow" size="24" tone="muted" /></button></block>
</view></view><view wx:if="{{!history}}" class="page-action-footer"><button class="primary-button" bindtap="create"><p-icon name="plus" tone="inverse" size="30" />添加提醒</button></view>
<view wx:if="{{selected}}" class="sheet-mask" bindtap="close"></view><view wx:if="{{selected}}" class="bottom-sheet"><view class="sheet-heading"><text>{{selected.title}}</text><button bindtap="close" aria-label="关闭"><p-icon name="close" /></button></view><view class="reminder-line">计划时间：{{selected.dueText}}</view><view class="reminder-line">完成时间：{{selected.completedText}}</view><view class="reminder-line">关联宠物：{{selected.petName || '无'}}</view><text class="reminder-note">{{selected.note || '没有备注'}}</text></view>
