<view class="page post-detail-page"><page-header title="帖子详情" back /><view class="screen-body"><view wx:if="{{loading}}" class="empty-state">正在读取这篇记录…</view><view wx:elif="{{error}}" class="empty-state"><p-icon name="post" tone="muted" size="64" /><text class="empty-title">暂时无法查看</text><text>{{error}}</text><button class="text-button" bindtap="loadPost">重新加载</button></view><block wx:elif="{{post}}"><view class="author-row"><p-image wx:if="{{post.avatar}}" image-class="author-avatar" src="{{post.avatar}}" /><view wx:else class="author-avatar avatar-placeholder"><p-icon name="cat" size="36" /></view><view class="author-copy"><text class="author-name">{{post.author}}</text><text class="author-time">{{post.editedText}}编辑</text></view><text wx:if="{{post.tag}}" class="tag">{{post.tag}}</text></view><view class="post-copy"><text class="post-title" selectable>{{post.title}}</text><text wx:if="{{post.displayBody}}" class="post-body" selectable>{{post.displayBody}}</text></view><view class="photo-stack"><view wx:for="{{post.images}}" wx:key="*this" class="photo-item" data-index="{{index}}" bindtap="previewImage" aria-label="查看大图"><p-image image-class="post-photo" src="{{item}}" mode="widthFix" /></view></view><text wx:if="{{post.images.length}}" class="photo-hint">轻点图片查看大图</text></block></view><view wx:if="{{post && !loading}}" class="detail-actions"><text class="action-caption">把有帮助的经验留在身边</text><button class="save-action {{saved ? 'is-saved' : ''}}" bindtap="toggleSave"><p-icon name="{{saved ? 'saved' : 'save'}}" tone="{{saved ? 'primary' : 'inverse'}}" size="30" />{{saved ? '已收藏' : '收藏帖子'}}</button></view></view>
