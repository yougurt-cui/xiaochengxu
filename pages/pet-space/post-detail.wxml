<view class="page post-detail-page"><page-header title="帖子详情" back /><view class="screen-body"><view wx:if="{{loading}}" class="empty-state">正在读取这篇记录…</view><view wx:elif="{{error}}" class="empty-state"><p-icon name="post" tone="muted" size="64" /><text class="empty-title">暂时无法查看</text><text>{{error}}</text><button class="text-button" bindtap="loadPost">重新加载</button></view><block wx:elif="{{post}}"><view class="author-row"><p-image wx:if="{{post.avatar}}" image-class="author-avatar" src="{{post.avatar}}" /><view wx:else class="author-avatar avatar-placeholder"><p-icon name="cat" size="36" /></view><view class="author-copy"><text class="author-name">{{post.author}}</text><text class="author-time">{{post.editedText}}编辑</text></view><text wx:if="{{post.tag}}" class="tag">{{post.tag}}</text></view><view class="post-copy"><text class="post-title" selectable>{{post.title}}</text><text wx:if="{{post.displayBody}}" class="post-body" selectable>{{post.displayBody}}</text></view><view class="photo-stack"><view wx:for="{{post.images}}" wx:key="*this" class="photo-item" data-index="{{index}}" bindtap="previewImage" aria-label="查看大图"><p-image image-class="post-photo" src="{{item}}" mode="widthFix" /></view></view><text wx:if="{{post.images.length}}" class="photo-hint">轻点图片查看大图</text></block></view><view wx:if="{{post && !loading && !reportVisible}}" class="detail-actions"><button wx:if="{{isOwner}}" class="text-button post-manage" bindtap="deletePost" loading="{{deleting}}" disabled="{{deleting}}">删除帖子</button><button wx:else class="text-button post-manage" bindtap="openReport">举报</button><button class="save-action {{saved ? 'is-saved' : ''}}" bindtap="toggleSave"><p-icon name="{{saved ? 'saved' : 'save'}}" tone="{{saved ? 'primary' : 'inverse'}}" size="30" />{{saved ? '已收藏' : '收藏帖子'}}</button></view></view>

<view wx:if="{{reportVisible}}" class="sheet-mask" bindtap="closeReport"></view>
<view wx:if="{{reportVisible}}" class="bottom-sheet report-sheet">
  <view class="sheet-heading"><text>举报帖子</text><button bindtap="closeReport" disabled="{{reporting}}" aria-label="关闭"><p-icon name="close" /></button></view>
  <view wx:if="{{reasonsLoading}}" class="caption">正在获取举报原因…</view>
  <view wx:if="{{reportError}}" class="caption">{{reportError}}<button wx:if="{{!reasons.length}}" class="text-button" bindtap="openReport">重试</button></view>
  <view class="report-reasons"><button wx:for="{{reasons}}" wx:key="code" size="mini" class="report-reason {{reason === item.code ? 'active' : ''}}" data-code="{{item.code}}" bindtap="chooseReason" disabled="{{reporting}}">{{item.label}}</button></view>
  <textarea class="report-detail" value="{{detail}}" bindinput="inputReport" maxlength="1000" placeholder="补充说明（选填）" disabled="{{reporting}}" />
  <button class="primary-button" bindtap="submitReport" loading="{{reporting}}" disabled="{{reporting || reasonsLoading || !reason}}">提交举报</button>
</view>
