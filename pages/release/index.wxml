<view class="page"><page-header title="记录它的小日常" back /><view class="screen-body"><text class="caption">分享真实经历，也记录每一点变化。</text><view class="form-field"><input data-key="title" value="{{title}}" bindinput="input" maxlength="40" placeholder="给这次记录起个标题（选填）" disabled="{{saving}}" /></view><view class="form-field"><textarea data-key="body" value="{{body}}" bindinput="input" maxlength="2000" placeholder="它遇到了什么问题？持续多久了？记录得详细一些，方便交流。" disabled="{{saving}}" /></view><view class="photo-grid"><view wx:for="{{images}}" wx:key="*this" class="photo" data-index="{{index}}" bindtap="previewImage"><p-image image-class="release-photo" src="{{item}}" mode="aspectFill" /><button data-index="{{index}}" catchtap="removeImage" aria-label="移除图片"><p-icon name="close" tone="inverse" size="24" /></button></view><button wx:if="{{images.length < 9}}" class="add-photo" aria-label="添加图片" bindtap="chooseImages" disabled="{{saving}}"><p-icon name="{{images.length ? 'plus' : 'image'}}" size="36" /><text wx:if="{{!images.length}}">添加图片</text></button></view><view class="topic-tags"><button size="mini" wx:for="{{categories}}" wx:key="id" class="topic-tag {{category === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCategory" disabled="{{saving}}"># {{item.label}}</button></view><text class="caption">草稿仅保存在当前设备。</text><view class="publish-actions"><button class="secondary-button" bindtap="saveDraft" disabled="{{saving}}">存草稿</button><button class="primary-button" bindtap="release" loading="{{saving}}" disabled="{{saving}}">{{saving ? '正在发布' : '发布帖子'}}</button></view></view></view>
