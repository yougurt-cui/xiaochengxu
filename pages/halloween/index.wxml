<view class="activity-page {{view !== 'home' ? 'activity-light' : ''}}">
  <page-header title="万圣节萌宠变装" back inverse="{{view === 'home'}}" />
  <view wx:if="{{preview}}" class="preview-banner">体验演示 · 示例兑换码不可兑换<button bindtap="previewStates">切换状态</button></view>

  <view wx:if="{{view === 'home'}}" class="activity-body">
    <block wx:if="{{status !== 'claimed'}}">
      <view class="activity-topline"><text class="brand-pill">宠析 × aibubu</text><button class="rules-link" data-view="rules" bindtap="openView">领取规则 ›</button></view>
      <view class="hero-title">万圣节，给毛孩子<text>换个魔法造型</text></view>
      <view class="hero-photo"><image src="assets/hero.png" mode="aspectFit" /><text>HALLOWEEN PET PARTY</text></view>
      <view class="claim-card">
        <view class="benefit-heading"><text class="tag">联名限量福利</text><button class="refresh-button {{loading ? 'is-refreshing' : ''}}" bindtap="refreshStatus" disabled="{{loading || claiming}}" aria-label="刷新任务和领取状态"><image src="assets/refresh.svg" mode="aspectFit" /></button></view>
        <view class="quota"><text>50</text><text>个名额 · 先到先得</text></view>
        <view wx:if="{{loading}}" class="status-box">正在查询任务与领取状态…</view>
        <view wx:elif="{{status === 'unavailable'}}" class="status-box"><text class="block-title">活动领取即将开放</text><text>开放后将自动检查任务与领取状态。</text></view>
        <view wx:elif="{{status === 'soldOut'}}" class="status-box"><text class="block-title">这次的魔法，已派送完</text><text>感谢参与，期待下次一起变萌！</text></view>
        <view wx:elif="{{status !== 'error'}}" class="task-card {{status === 'eligible' ? 'task-complete' : ''}}">
          <view class="task-copy"><text class="task-title">发布 1 条活动帖子</text><text class="task-description">{{status === 'eligible' ? '已完成 1/1 项' : '完成 0/1 项 · 发帖后返回检查进度'}}</text></view>
          <button wx:if="{{status === 'incomplete'}}" class="task-action" bindtap="goPost">去发帖 →</button>
          <text wx:else class="task-done">✓ 已达标</text>
        </view>
        <view wx:if="{{error}}" class="activity-error">{{error}}<button class="text-action" bindtap="refreshStatus" disabled="{{claiming}}">重新查询</button></view>
        <button wx:if="{{status !== 'soldOut'}}" class="activity-primary" bindtap="claim" loading="{{claiming}}" disabled="{{status !== 'eligible' || loading || claiming}}">{{claiming ? '领取中…' : loading ? '正在查询…' : status === 'unavailable' ? '即将开放' : status === 'error' ? '查询后可领取' : '立即领取兑换码'}}</button>
      </view>
      <view class="quick-links"><button data-view="guide" bindtap="openView">使用方法 ›</button></view>
      <text class="activity-footer">宠析 × aibubu 联合呈现</text>
    </block>
    <view wx:else class="success-view">
      <text class="tag">已领取</text><text class="success-title">魔法兑换码，到手！</text><text class="success-caption">快为毛孩子生成一张万圣节大片吧</text>
      <image class="success-photo" src="assets/success.png" mode="aspectFit" />
      <view class="code-card"><text class="tag">已领取</text><text class="code-label">专属生图兑换码{{record.preview ? '（演示）' : ''}}</text><text class="code-value" selectable>{{record.code}}</text><button class="activity-primary" bindtap="copyCode">复制兑换码</button></view>
      <text class="success-caption">兑换码已保存，再次进入活动页即可查看</text>
      <button class="activity-secondary" data-view="guide" bindtap="openView">查看使用方法 →</button>
    </view>
  </view>

  <view wx:elif="{{view === 'guide'}}" class="detail-body">
    <text class="detail-title">把魔法带到 aibubu</text><text class="detail-caption">兑换码在网站使用，小程序内领取与查看</text>
    <view class="guide-step" wx:for="{{steps}}" wx:key="title"><text class="step-number">{{index + 1}}</text><view><text class="block-title">{{item.title}}</text><text class="detail-caption">{{item.body}}</text></view></view>
    <view class="website"><text selectable>https://aibubu.cn/en</text><button bindtap="copyUrl">复制网址</button></view>
    <text class="detail-caption">请在个人空间兑换；同一活动每人限兑换一次。</text><text class="detail-caption">兑换有效期与可获额度以活动说明为准。</text>
  </view>
  <view wx:elif="{{view === 'rules'}}" class="detail-body">
    <text class="detail-title">奇妙夜，先读小规则</text><text class="tag warm">限量 50 名 · 先到先得</text>
    <view class="rule-item" wx:for="{{rules}}" wx:key="title"><text class="block-title">{{item.title}}</text><text class="detail-caption">{{item.body}}</text></view>
    <text class="detail-caption">活动时间、发帖要求及兑换有效期，请以正式活动公告为准。</text>
  </view>
</view>
