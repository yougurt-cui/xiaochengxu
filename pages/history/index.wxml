<view class="page"><page-header title="状态记录" back /><view class="screen-body"><text class="caption">每日累计 · 记录保存在当前设备</text><view wx:for="{{records}}" wx:key="day" class="record-card"><view class="section-heading"><text>{{item.day}}</text><text>{{item.time}} 更新</text></view><view class="record-values"><view><p-icon name="water" /><text>{{item.water}} ml</text><text class="caption">饮水</text></view><view><p-icon name="food" /><text>{{item.food}} g</text><text class="caption">进食</text></view><view><p-icon name="litter" /><text>{{item.litter}} 次</text><text class="caption">排便</text></view></view><view wx:for="{{item.litterNotes}}" wx:for-item="note" wx:key="index" class="caption litter-note">{{note.time}} · 排便 {{note.count}} 次 · {{note.shape}}</view></view><view wx:if="{{!records.length}}" class="empty-state"><p-icon name="history" size="72" /><text class="empty-title">从今天的一笔开始</text><text>在状态页记一笔，之后就能在这里回看。</text></view></view></view>
