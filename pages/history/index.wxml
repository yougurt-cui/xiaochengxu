<view class="page">
  <page-header title="状态记录" back />
  <view class="screen-body">
    <text class="caption">每日累计 · 记录保存在当前设备</text>
    <view wx:for="{{records}}" wx:key="day" class="record-card">
      <view class="record-heading"><text class="record-date">{{item.day}}</text><text class="record-updated">{{item.time}} 更新</text></view>
      <view class="record-values">
        <view class="record-metric"><view class="record-label"><p-icon name="water" size="28" /><text>饮水</text></view><view class="record-value"><text>{{item.water}}</text><text class="record-unit">ml</text></view></view>
        <view class="record-metric"><view class="record-label"><p-icon name="food" size="28" /><text>进食</text></view><view class="record-value"><text>{{item.food}}</text><text class="record-unit">g</text></view></view>
        <view class="record-metric"><view class="record-label"><p-icon name="litter" size="28" /><text>排便</text></view><view class="record-value"><text>{{item.litter}}</text><text class="record-unit">次</text></view></view>
      </view>
      <view wx:if="{{item.litterNotes.length}}" class="record-notes"><view wx:for="{{item.litterNotes}}" wx:for-item="note" wx:key="index" class="litter-note">{{note.time}} · 排便 {{note.count}} 次 · {{note.shape}}</view></view>
    </view>
    <view wx:if="{{!records.length}}" class="empty-state"><p-icon name="history" size="72" /><text class="empty-title">从今天的一笔开始</text><text>在状态页记一下，之后就能在这里回看。</text></view>
  </view>
</view>
