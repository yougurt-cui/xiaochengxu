<view class="page">
  <view style="height: {{statusBarHeight}}px"></view>
  <view class="navbar"><text class="back" bindtap="goBack">‹</text><text class="nav-title">历史数据</text><view class="pet-select">🐱 奶糖 · 3岁⌄</view></view>

  <view class="week-card card">
    <view class="pet-avatar">🐱</view>
    <view class="week-info"><text class="week-title">本周状态：<text>整体稳定</text></text><text class="week-date">5月12日 - 5月18日</text><view class="tags"><text class="blue-tag">♨ 饮水偏少</text><text class="green-tag">♟ 排便正常</text><text class="orange-tag">◉ 进食规律</text></view></view>
  </view>

  <view class="summary-grid">
    <view class="summary-card card"><text class="summary-title blue">♨ 饮水量</text><text class="period">本周日均</text><view><text class="summary-value blue">{{summary.water.value}}</text><text class="summary-unit"> {{summary.water.unit}}</text></view><text class="target">{{summary.water.target}}</text><view class="rate">{{summary.water.rate}}</view><canvas type="2d" id="waterSpark" class="spark"></canvas><view class="dates"><text>5/12</text><text>5/18</text></view></view>
    <view class="summary-card card"><text class="summary-title green">♟ 排便次数</text><text class="period">本周</text><view><text class="summary-value green">{{summary.litter.value}}</text><text class="summary-unit"> {{summary.litter.unit}}</text></view><text class="target">{{summary.litter.target}}</text><view class="rate">↗</view><canvas type="2d" id="litterSpark" class="spark"></canvas><view class="dates"><text>5/12</text><text>5/18</text></view></view>
    <view class="summary-card card"><text class="summary-title orange">◉ 进食次数</text><text class="period">本周</text><view><text class="summary-value orange">{{summary.feeding.value}}</text><text class="summary-unit"> {{summary.feeding.unit}}</text></view><text class="target">{{summary.feeding.target}}</text><view class="rate">—</view><canvas type="2d" id="feedingBars" class="spark"></canvas><view class="dates"><text>5/12</text><text>5/18</text></view></view>
  </view>

  <view class="trend card">
    <view class="trend-head"><text class="section-title">▥ 7日趋势</text><view class="metric-tabs"><text class="{{activeMetric === 'water' ? 'active' : ''}}" data-metric="water" bindtap="switchMetric">饮水</text><text class="{{activeMetric === 'litter' ? 'active' : ''}}" data-metric="litter" bindtap="switchMetric">排便</text><text class="{{activeMetric === 'feeding' ? 'active' : ''}}" data-metric="feeding" bindtap="switchMetric">进食</text></view></view>
    <view class="goal">目标 250ml</view>
    <canvas type="2d" id="trendCanvas" class="trend-canvas"></canvas>
    <view class="trend-note">♨ 本周日均 <text>138 ml</text>，低于目标 <text>44%</text><text class="arrow">›</text></view>
  </view>

  <view class="observations card">
    <view class="section-title">◉ 重点观察</view>
    <view wx:for="{{observations}}" wx:key="title" class="observation"><view class="observation-icon {{item.tone}}-soft">{{item.icon}}</view><view class="observation-info"><text class="observation-title {{item.tone}}">{{item.title}}</text><text class="observation-desc">{{item.desc}}</text></view><text class="chevron">›</text></view>
  </view>
</view>
