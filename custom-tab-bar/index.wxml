<view class="tab-bar"><button wx:for="{{list}}" wx:key="value" class="tab-item {{value === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="handleChange" aria-label="{{item.label}}" aria-current="{{value === item.value ? 'page' : ''}}"><p-icon name="{{item.icon}}" tone="{{value === item.value ? 'primary' : 'muted'}}" size="44" /><text>{{item.label}}</text></button></view>
